<?xml version="1.0" encoding="utf-8"?>
<!--
  One dock tile (W95).

  ⚠️ **This file exists because of `layout_width`, and nothing else.** The dock and
  the grid draw the same thing and used to share `item_app_tile.xml`, whose width
  is `match_parent`. That is right in the grid: a `GridLayoutManager` reads
  `match_parent` as one column. The dock is a **horizontal**
  `LinearLayoutManager`, where the same value means the full width of the
  RecyclerView — so the first favourite filled the dock and every other one was
  laid out off-screen.

  ⚠️ Nothing was lost when that happened. All four favourites were in the managed
  configuration and on the device; only one could be seen. A fault that destroys
  no data reports nothing, which is why it survived every test and every log.

  Kept as a second file rather than a width overridden in code, because the width
  is the *only* difference and a layout is where someone looks for it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="8dp"
    android:minWidth="72dp"
    android:minHeight="48dp"
    android:background="?android:attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:maxLines="1"
        android:maxWidth="96dp"
        android:ellipsize="end"
        android:textColor="@color/tile_label"
        android:shadowColor="@color/tile_label_shadow"
        android:shadowRadius="6"
        android:textSize="13sp" />
</LinearLayout>
