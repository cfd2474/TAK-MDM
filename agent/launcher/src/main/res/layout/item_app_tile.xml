<?xml version="1.0" encoding="utf-8"?>
<!--
  One app tile.

  ⚠️ 88dp of icon and a 48dp minimum touch target: this is a device that gets used
  outdoors, in gloves, mounted. GoTAK's `large_icon` exists for the same reason.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="8dp"
    android:minHeight="48dp"
    android:background="?android:attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/tile_label"
        android:shadowColor="@color/tile_label_shadow"
        android:shadowRadius="6"
        android:textSize="13sp" />
</LinearLayout>
