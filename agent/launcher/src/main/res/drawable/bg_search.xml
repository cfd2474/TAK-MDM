<?xml version="1.0" encoding="utf-8"?>
<!--
  ⚠️ The search field needs its own background. A default EditText under
  Theme.AppCompat is drawn light, and on this transparent, wallpapered window it
  came out as a white slab — the brightest thing on screen. Under the agent's
  night wash that slab becomes a glaring red panel, which is the exact opposite
  of what night mode is for.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/search_fill" />
    <stroke android:width="1dp" android:color="@color/search_stroke" />
    <corners android:radius="10dp" />
</shape>
