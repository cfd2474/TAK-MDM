<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Normal permission, granted at install. Required by WallpaperManager;
         Device Owner does not confer it. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!--
      Find-my-device (W107). A `normal` permission, granted at install — no
      runtime grant and nothing for the Device Owner to self-grant.
      MODIFY_AUDIO_SETTINGS is what allows the alarm volume to be raised for the
      duration of a ping and put back afterwards; without it the tablet stays
      silent on exactly the device someone is hunting for.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Kiosk and compliance overlays. An app-op: needs a one-time user grant. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!--
      Without an exemption the system eventually defers the sync service and the
      long-poll, turning immediate propagation into "sometime later" — a silent
      failure that looks like a server problem.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!--
      Periodic location reporting (W106). Three gates, and all three are needed:

      1. FINE/COARSE above - the runtime permission for a fix at all.
      2. ACCESS_BACKGROUND_LOCATION - because SyncService starts at BOOT_COMPLETED,
         and Android refuses to create a `location` foreground service from the
         background without it. The FGS type alone is NOT enough for us, which is
         easy to miss: the service type is the documented way to avoid this
         permission, but only for a service started while the app is visible.
      3. FOREGROUND_SERVICE_LOCATION - to declare the type at all.

      All are `dangerous` or `normal`, so `ensureSelfPermissions()` grants them
      during provisioning with no extra code.
    -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!--
      Configuring Wi-Fi networks from a NETWORKS policy. Both are `normal`
      permissions (auto-granted). The deprecated WifiManager config API
      (addNetwork/removeNetwork) is grandfathered for a Device Owner.
    -->
    <!--
      Bluetooth on/off from the kiosk's Device Settings screen (W72).

      A dangerous runtime permission, so `ensureSelfPermissions` grants it as
      Device Owner - unlike the overlay and accessibility grants, this one needs
      no person at the device.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!--
      Build.getSerial() needs this. Without it the agent falls back to ANDROID_ID,
      which changes on factory reset — so a wiped device enrols as a NEW record
      instead of re-adopting its own, breaking D24. Demonstrated: two SM-X520
      records for one tablet after reprovisioning.
    -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!--
      Removing apps a policy lists in removed_packages. As Device Owner the
      uninstall is silent, which is the point: an operator reclaiming storage or
      repurposing a tablet cannot be there to tap a confirmation dialog.
    -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!--
      All-files access, needed to place files into paths like /sdcard/atak that are
      not MediaStore collections. A Device Owner cannot grant this itself - it is an
      app-op, not a runtime permission - so the agent requests it once at setup.
      See R1 in PROJECT_STATE.md.
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!--
      Data usage reads (W44). A Device Owner is documented to get NetworkStats
      access for every app without this being granted - "Device owner apps and
      carrier-privileged apps likewise get access to usage data for all users on
      the device". Declared anyway as a fallback: that exemption is not yet proven
      on Samsung's firmware, and declaring the permission is what puts the app in
      Settings > Special access > Usage access, so a human can grant it if the
      exemption turns out not to hold. Harmless when it does.
    -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".AtlasMdmApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AtlasMdm">

        <!--
          The kiosk user's own settings screen (W71).

          ⚠️ `exported` because the ATLAS launcher starts it, and the launcher is a
          separate application. There is nothing to protect: it draws only what
          the Device Owner's own policy offers, so an app that started it on a
          device with no kiosk gets a screen saying nothing is available.

          `excludeFromRecents` and `noHistory` because it is a place a kiosk user
          steps into and out of, not somewhere to come back to — and in lock task
          a stale entry in recents is a way to re-enter a screen policy has since
          withdrawn.
        -->
        <!--
          The power menu service (W72).

          ⚠️ BIND_ACCESSIBILITY_SERVICE is what stops anything but the system
          binding it. The service observes nothing - see res/xml - and exists
          solely so an app can raise Android's power menu, which
          performGlobalAction is the only route to.

          ⚠️ It cannot be enabled from inside a kiosk: the switch lives in
          com.android.settings, which lock task blocks. It has to be granted
          before the device is locked down.
        -->
        <service
            android:name=".ui.PowerMenuService"
            android:exported="true"
            android:label="@string/power_menu_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/power_menu_service" />
        </service>

        <!--
          The Power tile on the kiosk home screen (W74).

          Transparent and with no animation: its whole job is to raise the power
          menu and get out of the way, and a window that appeared behind the menu
          would still be there when the user dismissed it.

          Exported so the launcher can start it; it checks the policy itself, so
          being exported does not make it a way round one.
        -->
        <activity
            android:name=".ui.PowerTileActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:icon="@drawable/ic_power_tile"
            android:label="@string/power_tile_title"
            android:theme="@style/Theme.Atlas.Invisible" />

        <!--
          The Wi-Fi picker, opened from Device Settings (W72).

          Not exported: only this app opens it, and it refuses to draw unless the
          policy offers Wi-Fi. An exported settings screen on a locked device
          would be a way round the policy rather than an expression of it.
        -->
        <activity
            android:name=".ui.WifiPickerActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:label="@string/wifi_pick_title" />

        <activity
            android:name=".ui.DeviceSettingsActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:icon="@drawable/ic_settings_gear"
            android:label="@string/settings_tile_title" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Required from Android 12. Without handlers for these two actions the
          system downloads the DPC, installs it, launches GET_PROVISIONING_MODE,
          finds nothing, and aborts with a bare "something went wrong".

          BIND_DEVICE_ADMIN on each activity is mandated too: it stops an
          arbitrary app launching them.
        -->
        <activity
            android:name=".admin.GetProvisioningModeActivity"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.app.action.GET_PROVISIONING_MODE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".admin.PolicyComplianceActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <intent-filter>
                <action android:name="android.app.action.ADMIN_POLICY_COMPLIANCE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          Not a launcher. The agent deliberately does not declare
          category.HOME - kiosk is opt-in per policy via lock task mode (F6),
          not an architectural commitment.
        -->

        <receiver
            android:name=".admin.MdmDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.PROFILE_PROVISIONING_COMPLETE" />
            </intent-filter>
        </receiver>

        <!--
          MY_PACKAGE_REPLACED as well as BOOT_COMPLETED. Replacing an app kills its
          processes, and nothing brings a foreground service back on its own - so
          without this an agent upgrade silently stops managing the device until it
          next reboots, and the server just sees a tablet that stopped checking in.
          Observed on SM-X520: 25 minutes of silence after an install -r.
        -->
        <receiver
            android:name=".sync.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
          ⚠️ `specialUse|location`, and the attribute is a bitmask so the original
          type is kept rather than replaced. Declaring `location` here is safe;
          what is NOT safe is *passing* it to startForeground() unconditionally.
          Android throws SecurityException when a type's runtime prerequisites are
          unmet, which "might cause a running foreground service to be removed
          from the foreground process state, and might cause your app to crash" —
          and this is the service that manages the device. SyncService therefore
          computes the type from what is actually granted (W106).
        -->
        <service
            android:name=".sync.SyncService"
            android:exported="false"
            android:foregroundServiceType="specialUse|location">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Device management: maintains the managed-configuration
                    connection to the MDM server and applies policy." />
        </service>

        <receiver
            android:name=".install.InstallResultReceiver"
            android:exported="false" />

        <!--
          Bench configuration for the `dpm set-device-owner` path, which carries no
          provisioning extras. Guarded by BuildConfig.DEBUG at runtime as well as
          being exported only so `adb shell am broadcast` can reach it.
        -->
        <receiver
            android:name=".admin.DebugConfigReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="com.taksolutions.atlasmdm.CONFIGURE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
