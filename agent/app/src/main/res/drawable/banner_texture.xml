<?xml version="1.0" encoding="utf-8"?>
<!--
  The banner's background: the ATLAS contour texture, tiled (W60).

  ⚠️ `tileMode` repeats the bitmap at its **intrinsic** size, so the asset's
  density bucket is what decides how big the tile looks. It ships at xhdpi
  (640x256 px = 320x128 dp), which is the scale that read as texture rather than
  as an obviously repeating motif; Android rescales it for other densities.

  A `<bitmap>` rather than the flat `atlas_banner_field` colour it replaces. The
  logo drawn over it carries its own dark field, and the two blend because both
  are the same near-black navy — #000818 in the pattern against #010915 at the
  logo's edges.
-->
<bitmap xmlns:android="http://schemas.android.com/apk/res/android"
    android:src="@drawable/atlas_pattern"
    android:tileMode="repeat" />
