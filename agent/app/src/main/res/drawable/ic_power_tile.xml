<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive, so the tile is masked and sized like every other icon on the grid
     rather than sitting at a different scale beside them (W74). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_settings_gear_background" />
    <foreground android:drawable="@drawable/ic_power_tile_foreground" />
    <monochrome android:drawable="@drawable/ic_power_tile_foreground" />
</adaptive-icon>
