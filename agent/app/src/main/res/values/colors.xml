<?xml version="1.0" encoding="utf-8"?>
<!-- ATLAS MDM palette, drawn from the app icon: dark navy field, electric blue,
     brushed steel. -->
<resources>
    <color name="atlas_navy_deep">#FF071528</color>
    <color name="atlas_navy">#FF0B1E37</color>
    <color name="atlas_navy_panel">#FF102A4C</color>
    <color name="atlas_navy_line">#FF1E4E86</color>

    <color name="atlas_blue">#FF1E7BE8</color>
    <color name="atlas_blue_bright">#FF2E9BFF</color>
    <color name="atlas_cyan">#FF4FC3FF</color>

    <color name="atlas_steel">#FFB7C0CC</color>
    <color name="atlas_steel_dim">#FF8A97A6</color>

    <color name="atlas_text">#FFE7EDF4</color>
    <color name="atlas_text_muted">#FF9DB0C4</color>

    <color name="atlas_ok">#FF3ECF8E</color>
    <color name="atlas_warn">#FFF0A73B</color>
    <color name="atlas_error">#FFFF5C6C</color>

    <color name="atlas_on_blue">#FFFFFFFF</color>
    <!-- The ATLAS artwork's own background. The banner and splash sit on this
         rather than on atlas_navy_deep, so the image blends into its surround
         instead of showing as a black rectangle pasted onto navy (W55). -->
    <color name="atlas_logo_field">#FF000203</color>
    <!-- The slim banner artwork's own field, sampled from the left and right
         edge columns that actually abut the bar (avg #010915).

         Deliberately separate from atlas_logo_field: the slim logo sits on a dark
         *navy*, the full logo on near-black, and one value for both leaves a
         visible seam around the centred image. Sampling the whole border was worse
         still — the artwork is vignetted, so its top and bottom edges are lighter
         than its sides, and averaging all four produced a bar that showed the logo
         as a pasted-on rectangle. The banner is drawn flush to the bar's full
         height, so only the side edges are ever seen (W55). -->
    <color name="atlas_banner_field">#FF010915</color>
</resources>
