<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ATLAS MDM: a dark, navy console. Committed to one look — the agent is a
         fixed-purpose fleet tool, not a consumer app that should follow the
         system light/dark toggle. -->
    <style name="Theme.AtlasMdm" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/atlas_blue_bright</item>
        <item name="colorOnPrimary">@color/atlas_on_blue</item>
        <item name="colorPrimaryContainer">@color/atlas_blue</item>
        <item name="colorOnPrimaryContainer">@color/atlas_on_blue</item>

        <item name="colorSecondary">@color/atlas_cyan</item>
        <item name="colorOnSecondary">@color/atlas_navy_deep</item>

        <item name="android:colorBackground">@color/atlas_navy_deep</item>
        <item name="colorSurface">@color/atlas_navy</item>
        <item name="colorSurfaceContainer">@color/atlas_navy_panel</item>
        <item name="colorSurfaceContainerHigh">@color/atlas_navy_panel</item>
        <item name="colorOnSurface">@color/atlas_text</item>
        <item name="colorOnSurfaceVariant">@color/atlas_text_muted</item>
        <item name="colorOutline">@color/atlas_navy_line</item>

        <item name="colorError">@color/atlas_error</item>

        <item name="android:statusBarColor">@color/atlas_navy_deep</item>
        <item name="android:navigationBarColor">@color/atlas_navy_deep</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- ⚠️ From Android 12 the system draws its own splash on every cold
             start and an app **cannot** suppress it (minSdk here is 33, so this
             always applies). Our 3-second logo splash therefore runs *after* it,
             and left alone the operator would see two unrelated splashes in a
             row, which reads as a bug rather than a brand.

             Painting the system splash in the logo's own field colour makes the
             handover invisible: the same near-black is on screen throughout, and
             only the artwork changes. -->
        <item name="android:windowSplashScreenBackground">@color/atlas_logo_field</item>
    </style>

    <style name="Widget.Atlas.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/atlas_navy_panel</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/atlas_navy_line</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPadding">16dp</item>
    </style>

    <style name="TextAppearance.Atlas.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/atlas_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.Atlas.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/atlas_text_muted</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <style name="TextAppearance.Atlas.Value" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/atlas_text</item>
    </style>

    <style name="TextAppearance.Atlas.Mono" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/atlas_steel</item>
        <item name="android:textIsSelectable">true</item>
    </style>

    <!--
      For an activity that exists only to do something and finish (W74).

      windowIsTranslucent with a null background and no animation: anything else
      shows an empty window for a frame between the tap and the power menu.
    -->
    <style name="Theme.Atlas.Invisible" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
