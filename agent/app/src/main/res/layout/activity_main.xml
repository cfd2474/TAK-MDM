<?xml version="1.0" encoding="utf-8"?>
<!-- A FrameLayout root so the splash can sit *over* the finished screen (W55).
     Overlaying rather than using a separate splash Activity keeps one launcher
     entry and avoids the blank frame between two activities. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/atlas_navy_deep">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/atlas_navy_deep"
    android:orientation="vertical">

    <!-- Header: the ATLAS logo, centred on the contour texture.

         ⚠️ The symmetric 132dp margins are what let the logo be **centred on the
         bar** while the Sync button sits at the end of the same bar. Reserving the
         button's footprint on *both* sides keeps the midpoint of the free space on
         the midpoint of the bar — centring it without them would put the logo
         under the button on a narrow screen. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/banner_texture">

        <!-- The logo fills the bar's full height: 64dp, no vertical margin. The
             asset is trimmed to its own opaque bounds, so "64dp" is 64dp of
             artwork — the globe's spike reaches the top edge and the arrow's
             point the bottom.

             ⚠️ It only fills the height while **width** is not the binding
             constraint. `fitCenter` honours the aspect ratio, so between the
             132dp margins below a screen of about 600dp the logo is limited by
             the width instead and draws shorter than the bar — 45dp on a 411dp
             phone. That is the margins doing their job (see above); the fix, if
             a phone ever matters, is the margins, not this height. -->
        <ImageView
            android:id="@+id/header_banner"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:layout_marginStart="132dp"
            android:layout_marginEnd="132dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/atlas_banner" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sync_now"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="12dp"
            android:text="@string/action_sync_now"
            app:icon="@drawable/ic_sync"
            app:iconGravity="textStart" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/atlas_navy_line" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/section_device"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/container_device"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <ScrollView
            android:id="@+id/section_permissions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/container_permissions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <ScrollView
            android:id="@+id/section_apps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/container_apps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <ScrollView
            android:id="@+id/section_files"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/container_files"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <ScrollView
            android:id="@+id/section_policies"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/container_policies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/atlas_navy"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav" />
</LinearLayout>

    <!-- Splash (W55). Drawn over the finished screen and removed after 3s, so
         there is no second Activity and no blank frame handing over to one.

         `clickable` is not decoration: without it, taps land on the live UI
         underneath while the splash is still covering it. -->
    <FrameLayout
        android:id="@+id/splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/atlas_logo_field"
        android:clickable="true"
        android:focusable="true">

        <!-- fitCenter, not centerCrop: the splash is where the whole logo is
             meant to be readable, tagline included. -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:scaleType="fitCenter"
            android:src="@drawable/atlas_wordmark" />
    </FrameLayout>
</FrameLayout>
