<?xml version="1.0" encoding="utf-8"?>
<!-- A FrameLayout root so the splash can sit *over* the finished screen (W55).
     Overlaying rather than using a separate splash Activity keeps one launcher
     entry and avoids the blank frame between two activities. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/atlas_navy_deep">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/atlas_navy_deep"
    android:orientation="vertical">

    <!-- Header: the ATLAS logo, centred on the contour texture.

         ⚠️ The symmetric 132dp margins are what let the logo be **centred on the
         bar** while the Sync button sits at the end of the same bar. Reserving the
         button's footprint on *both* sides keeps the midpoint of the free space on
         the midpoint of the bar — centring it without them would put the logo
         under the button on a narrow screen. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/banner_texture">

        <!-- ⚠️ 56dp plus 4dp above and below, **not** 64dp flush. The artwork
             this replaced was opaque and had to run edge to edge, or its lighter
             top and bottom showed as two seams and it read as a rectangle pasted
             on the bar. This one has a real alpha channel and sits *on* the
             texture, so the old constraint is gone — and drawn flush at 64dp the
             globe's top spike touches the bar edge. The 4dp is the breathing
             room; the 56+4+4 keeps the bar's height exactly what it was. -->
        <ImageView
            android:id="@+id/header_banner"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:layout_marginStart="132dp"
            android:layout_marginEnd="132dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/atlas_banner" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sync_now"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="12dp"
            android:text="@string/action_sync_now"
            app:icon="@drawable/ic_sync"
            app:iconGravity="textStart" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/atlas_navy_line" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/section_device"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/container_device"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <ScrollView
            android:id="@+id/section_permissions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/container_permissions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <ScrollView
            android:id="@+id/section_apps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/container_apps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <ScrollView
            android:id="@+id/section_files"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/container_files"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <ScrollView
            android:id="@+id/section_policies"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/container_policies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/atlas_navy"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav" />
</LinearLayout>

    <!-- Splash (W55). Drawn over the finished screen and removed after 3s, so
         there is no second Activity and no blank frame handing over to one.

         `clickable` is not decoration: without it, taps land on the live UI
         underneath while the splash is still covering it. -->
    <FrameLayout
        android:id="@+id/splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/atlas_logo_field"
        android:clickable="true"
        android:focusable="true">

        <!-- fitCenter, not centerCrop: the splash is where the whole logo is
             meant to be readable, tagline included. -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:scaleType="fitCenter"
            android:src="@drawable/atlas_wordmark" />
    </FrameLayout>
</FrameLayout>
