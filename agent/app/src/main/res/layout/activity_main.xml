<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:paddingBottom="24dp"
            android:textIsSelectable="true" />

        <Button
            android:id="@+id/sync_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_sync_now" />

        <Button
            android:id="@+id/open_marketplace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_open_marketplace" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="@string/storage_rationale"
            android:textSize="12sp" />

        <Button
            android:id="@+id/grant_storage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_review_permissions" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="24dp"
            android:text="@string/reenroll_rationale"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/reenroll_token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:hint="@string/reenroll_hint"
            android:inputType="textNoSuggestions"
            android:textSize="12sp" />

        <Button
            android:id="@+id/reenroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_reenroll" />
    </LinearLayout>
</ScrollView>
