# Release signing for ATLAS. Copy to keystore.properties and fill in.
#
# WARNING: keystore.properties is gitignored and must stay that way. The key it
# names is the fleet's identity: a signature change cannot be delivered over the
# update channel (Android refuses it), so losing this key strands every device
# that ever installed a build signed by it.
#
# WARNING: use a keystore that belongs to ATLAS and nothing else. Until v1.34.0
# this pointed at a general-purpose workstation keystore that also signed an app
# on Google Play, which put a Play listing and every customer's fleet behind one
# secret. tests/test_signing_key.py now fails if anything in dist/ carries that
# key's fingerprint.
#
# See docs/AGENT-SIGNING-KEY.md for generation, custody and the recovery
# position.
storeFile=D:/Code/ANDROID/ATLAS Signing/atlas-release.jks
storePassword=
keyAlias=atlas
keyPassword=
