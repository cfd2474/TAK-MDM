__pycache__/
*.pyc
.venv/
.pytest_cache/
.env
.vscode/
*.db

# Uploaded APKs and their extracted splits. Leading slash matters: an unanchored
# "artifacts/" would also exclude the app/artifacts source package.
/artifacts/

# Device CA. The private key here can mint any device identity — never commit it.
/pki/
*.key
*.pem

# Android agent build output and machine-local SDK path.
agent/.gradle/
agent/build/
agent/*/build/
agent/local.properties
*.apk

# Generated provisioning payloads embed a live enrollment token.
qr_payload*.json

# Real vendor APKs used for hardware testing. Hundreds of megabytes, and not ours
# to redistribute.
Test Files/
