__pycache__/
*.pyc
.venv/
.pytest_cache/
.env
.vscode/
*.db

# Uploaded APKs and their extracted splits. Leading slash matters: an unanchored
# "artifacts/" would also exclude the app/artifacts source package.
/artifacts/

# Device CA. The private key here can mint any device identity — never commit it.
/pki/
*.key
*.pem

# Android agent build output and machine-local SDK path.
agent/.gradle/
agent/build/
agent/*/build/
agent/local.properties
*.apk
# ...except the two applications a deployment ships with. They are release
# artifacts of the tagged version, not build products: an InfraTAK module
# installs by cloning this repository at a tag, the box has no Android
# toolchain, and a private repo's release assets cannot be fetched with the
# read-only SSH deploy key the module clones with. See dist/README.md.
!dist/*.apk

# Release signing for the agent. The key is the fleet's identity — a signature
# change cannot be delivered over the update channel, so this is closer to the
# device CA than to a build flag. The .example template is committed; this is not.
agent/keystore.properties

# Generated provisioning payloads embed a live enrollment token.
qr_payload*.json

# Real vendor APKs used for hardware testing. Hundreds of megabytes, and not ours
# to redistribute.
Test Files/

# Local scratch space for hardware testing.
scratch/

# Vendored UI/UX Pro Max skill (github.com/nextlevelbuilder/ui-ux-pro-max-skill),
# installed per-developer. Not part of this project's source.
.claude/skills/

# Downloaded repository indexes (W98). Re-fetchable, and F-Droid alone is 59 MB.
cache/

# Written at pack time by scripts/write_build.py (W102). Per-deploy, never committed.
BUILD
